# -----------------------------------------------------------------------------
# Enterprise AI Knowledge Management Platform - Environment Configurations
# -----------------------------------------------------------------------------
# Duplicate this file to '.env' and populate actual values for production.
# DO NOT commit '.env' containing real secrets to source control.

# --- Database Configurations ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=knowledge_db
DB_USER=postgres
DB_PASSWORD=postgres

# --- Caching Configurations ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- AI Model Configurations ---
# Google Gemini API key mapped via OpenAI compatibility endpoints
GEMINI_API_KEY=your-gemini-api-key-here

# --- Ingestion & Storage Mappings ---
FILE_STORAGE_PATH=/opt/platform/storage

# --- Next.js Client Configurations ---
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
